# Copia este archivo como `.env.local` y pon tus credenciales.
# Están en Supabase → tu proyecto → Settings → API.
#
# El modo online NO usa base de datos: solo Realtime (Presence + Broadcast).
# No hay que crear tablas ni ejecutar SQL. Sin estas dos variables el modo
# online no puede conectarse (el modo local sigue funcionando).

NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
